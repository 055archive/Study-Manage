rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: cek apakah user sudah login
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function: cek apakah user adalah pemilik dokumen ini
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function: cek apakah user memiliki wewenang Pengurus / Admin
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profile.role != 'Mahasiswa' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profile.isAdmin == true
        );
    }

    // 1. DATA PRIBADI MAHASISWA (users/{userId} & subkoleksi)
    match /users/{userId} {
      // Pemilik akun selalu berhak penuh. Admin berhak membaca untuk rekap kelas.
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();

      // Subkoleksi: tugas, materi, matkul, tugas_status
      match /{subcollection=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // 2. INDEKS NIM (nim_index/{nim})
    match /nim_index/{nim} {
      // Boleh lookup 1 dokumen NIM untuk keperluan verifikasi login/reset
      allow get: if true;
      // Dilarang melakukan listing massal (mencegah scraping seluruh NIM)
      allow list: if isAdmin();
      // Pendaftaran NIM baru diizinkan jika belum ada
      allow create: if true;
      // Modifikasi/penghapusan hanya diizinkan oleh pemilik akun atau admin
      allow update, delete: if isAuthenticated() && (
        resource.data.uid == request.auth.uid || isAdmin()
      );
    }

    // 3. TUGAS RESMI KELAS (kelas_tugas/{taskId})
    match /kelas_tugas/{taskId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || (
        isAuthenticated() && 
        (resource == null || resource.data.authorUid == request.auth.uid)
      );
    }

    // 4. MATERI RESMI KELAS (kelas_materi/{materiId})
    match /kelas_materi/{materiId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || (
        isAuthenticated() && 
        (resource == null || resource.data.authorUid == request.auth.uid)
      );
    }

    // 5. INFORMASI & PENGUMUMAN KELAS (kelas_info/{infoId})
    match /kelas_info/{infoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
  }
}
