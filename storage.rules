rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Isolasi berkas lampiran tugas & materi per pengguna
    match /portal-kuliah/{userId}/{allPaths=**} {
      // Seluruh mahasiswa yang login dapat mengunduh berkas materi / tugas
      allow read: if request.auth != null;
      
      // Hanya pemilik berkas yang boleh upload / hapus, batas berkas maksimal 25MB
      allow write: if request.auth != null && request.auth.uid == userId 
                   && request.resource.size < 25 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
